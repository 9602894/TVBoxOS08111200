<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <!-- 直播订阅 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="直播订阅"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvLiveSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击设置直播订阅"
            android:textColor="#00BFFF"
            android:textSize="14sp"
            android:padding="8dp 16dp"
            android:background="#333333"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvLiveClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除"
            android:textColor="#FF4444"
            android:textSize="14sp"
            android:padding="8dp 12dp"
            android:layout_marginStart="8dp"
            android:background="#333333"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- EPG订阅 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EPG订阅"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvEpgSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击设置EPG订阅"
            android:textColor="#00BFFF"
            android:textSize="14sp"
            android:padding="8dp 16dp"
            android:background="#333333"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvEpgClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除"
            android:textColor="#FF4444"
            android:textSize="14sp"
            android:padding="8dp 12dp"
            android:layout_marginStart="8dp"
            android:background="#333333"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提示：设置后需重启播放或刷新页面生效"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"/>

</LinearLayout>
